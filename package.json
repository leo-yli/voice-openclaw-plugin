{
  "name": "@xalgo/voice-openclaw-plugin",
  "version": "2026.5.16",
  "type": "module",
  "description": "通过 Xalgo 眼镜语音接入 OpenClaw Agent，使用 8 位绑定码完成账号绑定。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/postbuild.mjs",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepare": "tsc && node scripts/postbuild.mjs",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "bin": {
    "xalgo-bind": "./dist/bin/xalgo-bind.js"
  },
  "files": [
    "dist",
    "scripts",
    "endpoints.json",
    "openclaw.plugin.json",
    "README.md",
    "README.en.md"
  ],
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "channel": {
      "id": "xalgo_voice",
      "label": "Xalgo Voice",
      "selectionLabel": "Xalgo Voice（Xalgo 眼镜语音接入 OpenClaw）",
      "blurb": "通过 Xalgo 眼镜语音控制 OpenClaw Agent，使用 8 位绑定码完成绑定。"
    },
    "install": {
      "npmSpec": "@xalgo/voice-openclaw-plugin",
      "localPath": "extensions/xalgo-voice-openclaw-plugin"
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
