{
  "id": "xalgo_voice",
  "name": "Xalgo Voice",
  "version": "2026.5.16",
  "description": "Voice channel plugin that connects Xalgo glasses and Pupa voice cloud to OpenClaw agents.",
  "main": "./dist/index.js",
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "xalgo_voice",
      "label": "Xalgo Voice",
      "selectionLabel": "Xalgo Voice (语音)",
      "docsPath": "/channels/xalgo-voice",
      "blurb": "Talk to your OpenClaw agents through Xalgo voice devices.",
      "order": 200
    },
    "install": {
      "npmSpec": "@xalgo/voice-openclaw-plugin",
      "localPath": "extensions/xalgo-voice",
      "defaultChoice": "npm"
    }
  },

  "channels": ["xalgo_voice"],

  "channelConfigs": {
    "xalgo_voice": {
      "label": "Xalgo Voice",
      "description": "Talk to your OpenClaw agents through Xalgo voice devices via 8-digit binding code.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "token": { "type": "string", "default": "", "description": "由绑定向导写入，install 时为空" },
          "instanceId": { "type": "string", "default": "" },
          "serverUrl": { "type": "string" },
          "apiBaseUrl": { "type": "string" },
          "deviceLabel": { "type": "string" },
          "boundAt": { "type": "string" },
          "boundUserId": { "type": "string" },
          "boundUserName": { "type": "string" },
          "agentId": { "type": "string", "default": "voice" },
          "sessionPrefix": { "type": "string", "default": "xalgo_voice" },
          "streaming": { "type": "boolean", "default": true },
          "replyMode": { "type": "string", "enum": ["voice_first", "text_first", "both"], "default": "voice_first" },
          "riskPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "confirmExternalSend": { "type": "boolean", "default": true },
              "confirmDangerousTools": { "type": "boolean", "default": true },
              "allowPureVoiceR3": { "type": "boolean", "default": false }
            }
          },
          "reconnect": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minDelayMs": { "type": "number", "default": 1000 },
              "maxDelayMs": { "type": "number", "default": 30000 },
              "resume": { "type": "boolean", "default": true }
            }
          }
        },
        "required": []
      },
      "uiHints": {
        "token": { "label": "Channel Token", "sensitive": true, "placeholder": "xalgo_channel_..." },
        "serverUrl": { "label": "WebSocket URL" },
        "apiBaseUrl": { "label": "API Server URL" },
        "agentId": { "label": "Agent ID" },
        "streaming": { "label": "Streaming Replies" },
        "replyMode": { "label": "Reply Mode" },
        "instanceId": { "label": "Instance ID (managed)", "readonly": true },
        "deviceLabel": { "label": "Device Label" },
        "boundAt": { "label": "Bound At (managed)", "readonly": true },
        "boundUserId": { "label": "Bound User ID (managed)", "readonly": true },
        "boundUserName": { "label": "Bound User (display)", "readonly": true }
      },
      "commands": {
        "nativeCommandsAutoEnabled": true
      }
    }
  },

  "setup": {
    "requiresRuntime": true
  },

  "activation": {
    "onStartup": false,
    "onChannels": ["xalgo_voice"]
  },

  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": false },
      "token": { "type": "string", "default": "" },
      "instanceId": { "type": "string", "default": "" },
      "serverUrl": { "type": "string" },
      "apiBaseUrl": { "type": "string" },
      "deviceLabel": { "type": "string" },
      "boundAt": { "type": "string" },
      "boundUserId": { "type": "string" },
      "boundUserName": { "type": "string" },
      "agentId": { "type": "string", "default": "voice" },
      "sessionPrefix": { "type": "string", "default": "xalgo_voice" },
      "streaming": { "type": "boolean", "default": true },
      "replyMode": { "type": "string", "enum": ["voice_first", "text_first", "both"], "default": "voice_first" },
      "riskPolicy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "confirmExternalSend": { "type": "boolean", "default": true },
          "confirmDangerousTools": { "type": "boolean", "default": true },
          "allowPureVoiceR3": { "type": "boolean", "default": false }
        }
      },
      "reconnect": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "minDelayMs": { "type": "number", "default": 1000 },
          "maxDelayMs": { "type": "number", "default": 30000 },
          "resume": { "type": "boolean", "default": true }
        }
      }
    },
    "required": []
  },

  "uiHints": {
    "token": { "label": "Channel Token", "sensitive": true, "placeholder": "xalgo_channel_..." },
    "serverUrl": { "label": "WebSocket URL" },
    "apiBaseUrl": { "label": "API Server URL" },
    "agentId": { "label": "Agent ID" },
    "streaming": { "label": "Streaming Replies" },
    "replyMode": { "label": "Reply Mode" },
    "instanceId": { "label": "Instance ID (managed)", "readonly": true },
    "deviceLabel": { "label": "Device Label" },
    "boundAt": { "label": "Bound At (managed)", "readonly": true },
    "boundUserId": { "label": "Bound User ID (managed)", "readonly": true },
    "boundUserName": { "label": "Bound User (display)", "readonly": true }
  }
}
